# --- Security & Personal Data ---
# Do NOT remove these; they protect your keys and progress
config.py
brain.json
users/
project_state.md
goal_prompt
.env

# --- Python Clutter ---
__pycache__/
*.py[cod]
*$py.class
venv/
env/

# --- Vendored / Derived Data ---
# NOTE: stroke_data.json (~6.6 MB) and vendor/hanzi-writer.min.js are both
# deliberately TRACKED, not ignored. They're what makes handwriting work with
# no network, so a fresh clone is offline-capable without a build step.
# Regenerate the stroke data with fetch_stroke_data.py if the character set
# ever needs widening.

# --- Operating System Junk ---
# NOTE: gitignore has no trailing-comment syntax, so these previously read as
# literal patterns ending in "# macOS folder attributes" and matched nothing.
.DS_Store
Thumbs.db
*.swp
*~

# --- Web/PWA Clutter ---
node_modules/
.eslintcache
